# Postgres connection (Render Postgres in production; local dev instance here)
DATABASE_URL=postgres://clipper:clipper_dev@localhost:5432/clipper_dev

# OpusClip API (https://help.opus.pro/api-reference/overview)
OPUSCLIP_API_KEY=

# Google API key with Drive API + Docs export enabled (public-file read only, no OAuth)
GOOGLE_API_KEY=

# Claude API (requirements extraction)
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible export storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipper-exports

# Needs Attention / pending-confirmation alerts. A webhook URL (e.g. Slack incoming webhook).
NOTIFY_WEBHOOK_URL=

# Public base URL of the deployed API, used to register the OpusClip webhook callback.
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret OpusClip should echo back on webhook calls, if/when confirmed against a real account.
OPUSCLIP_WEBHOOK_SECRET=

PORT=3000
