# Copy to .env for local development. Never commit real values.
# Each entry point validates only the variables it uses (see src/config.ts).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipper
# Only against Supabase: its root CA (PEM) so TLS is verified. See docs/DEPLOYMENT.md.
DATABASE_CA_CERT=
# Used only by the test suite (DB tests are skipped if unset).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipper_test

# Review web app
PORT=3000
REVIEWER_TOKEN=
# 1 behind Render's proxy, 0 when run directly
TRUST_PROXY_HOPS=0
# Enables POST /operator/run (32+ chars). Unset = off.
OPERATOR_TOKEN=

# Operator's cloud environment only: run CLI commands on the review app over HTTPS
# instead of connecting to Postgres (see docs/DEPLOYMENT.md).
CLIPPER_REMOTE_URL=
CLIPPER_OPERATOR_TOKEN=

# Credit budget for OpusClip submissions (~1 credit per source-video minute)
OPUSCLIP_DAILY_CREDIT_BUDGET=120

# Ready-to-Post storage (clipper package)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Notifications (clipper notify)
NOTIFY_WEBHOOK_URL=
# Optional: the review web app's public URL, linked from notifications
REVIEW_URL=
