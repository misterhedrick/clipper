{
  "permissions": {
    "deny": [
      "mcp__OpusClip__opusclip_create_post_task",
      "mcp__OpusClip__opusclip_schedule_publish",
      "mcp__OpusClip__opusclip_unschedule_publish",
      "mcp__OpusClip__opusclip_share_project",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__send_later"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__OpusClip__opusclip_submit_project",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-opusclip-submit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
